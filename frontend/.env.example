# ORDO Frontend Environment Configuration
# Target Runtime: Vercel (Next.js 14 App Router)

# Production Frontend Web Application Origin (without trailing slash)
NEXT_PUBLIC_APP_URL=https://ordo-app.vercel.app

# Production Backend API Base URL
# Option A (Recommended with Vercel rewrites): '/api/v1' (same-origin, no third-party cookie restrictions)
# Option B (Direct Cross-Origin): 'https://your-backend-app.onrender.com/api/v1'
NEXT_PUBLIC_API_BASE_URL=https://your-backend-app.onrender.com/api/v1

# Internal Backend Target for Next.js Rewrites (used when NEXT_PUBLIC_API_BASE_URL is /api/v1)
BACKEND_INTERNAL_URL=https://your-backend-app.onrender.com

# Public Google OAuth Client ID (matches GOOGLE_CLIENT_ID in backend, safe for browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
