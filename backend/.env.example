# ORDO Backend Environment Configuration
# Target Runtime: Render Web Service (Node.js 20+)

# Environment & Server Port (Render automatically injects PORT)
NODE_ENV=production
PORT=5000

# Frontend URL(s) for CORS & CSRF Whitelisting
# Set to your production Vercel URL without trailing slash
FRONTEND_URL=https://ordo-app.vercel.app
# Optional: comma-separated list of additional preview or custom domain origins
ALLOWED_ORIGINS=https://ordo-app-preview.vercel.app,https://app.ordo.com

# Cookie SameSite policy: 'none' for cross-domain (Vercel + Render), 'lax' for shared custom domain
COOKIE_SAME_SITE=none

# MongoDB Atlas TLS Connection URI (Least-privilege app user, never admin)
# Obtain from MongoDB Atlas -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/ordo?retryWrites=true&w=majority

# Session & JWT Secrets (Must be unique, cryptographically random strings of >= 32 chars in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-32-character-session-secret-here
ACCESS_TOKEN_SECRET=your-32-character-access-token-secret-here
REFRESH_TOKEN_SECRET=your-32-character-refresh-token-secret-here

# Google OAuth 2.0 (Google Cloud Console Web Application credentials)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
# Production OAuth Callback URLs (Must match registered redirect URIs in Google Cloud Console)
GOOGLE_CALLBACK_URL=https://your-backend-app.onrender.com/api/v1/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URL=https://your-backend-app.onrender.com/api/v1/calendar/google/callback

# AES-256 Symmetric Encryption Key for Stored OAuth Tokens (Exactly 32 ASCII characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
OAUTH_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Email Service (Optional: Resend / SendGrid API Key)
EMAIL_PROVIDER_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# AI Provider Service (Optional: Gemini / OpenAI API Key for AI Insights)
AI_PROVIDER_API_KEY=your_ai_api_key_here

# Redis Queue (Optional: for high-throughput background queues if external worker is enabled)
REDIS_URL=rediss://default:your-password@your-redis-host:6379
